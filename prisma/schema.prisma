generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  monthlyIncome  Decimal         @default(0) @db.Decimal(12, 2)
  banks          Bank[]
  expenses       Expense[]
  monthlyIncomes MonthlyIncome[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Bank {
  id        String    @id @default(cuid())
  userId    String
  name      String
  color     String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, name])
}

model Expense {
  id          String    @id @default(cuid())
  userId      String
  bankId      String
  name        String
  amount      Decimal   @db.Decimal(12, 2)
  isRecurring Boolean   @default(true)
  startMonth  DateTime
  endMonth    DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank        Bank      @relation(fields: [bankId], references: [id], onDelete: Restrict)
  payments    Payment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Payment {
  id        String   @id @default(cuid())
  expenseId String
  month     DateTime
  paidAt    DateTime @default(now())
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, month])
}

model MonthlyIncome {
  id        String   @id @default(cuid())
  userId    String
  month     DateTime
  amount    Decimal  @db.Decimal(12, 2)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
}
