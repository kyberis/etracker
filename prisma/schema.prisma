generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Tipo de movimiento en la pila global de ahorros (`User.savings`).
/// La pila es la suma firmada de todos los `SavingsMovement` del usuario.
enum SavingsMovementKind {
  /// Aporte mensual informativo: el usuario declara cuánto dedica a ahorro
  /// para un mes dado. NO afecta el balance del mes (no se descuenta de
  /// `MonthRecord.income` ni aparece como `MonthExpenseLine`); solo suma a
  /// la pila. Único por (`userId`, `monthRecordId`).
  MONTHLY_CONTRIBUTION
  /// Sobrante del mes anterior derivado a ahorros via `applyPrevMonthLeftoverDecision`
  /// con `mode = "setAside"`. Único por (`userId`, `monthRecordId`).
  CARRYOVER_DEPOSIT
  /// Salida (firmado negativo) que cubre el saldo negativo del mes anterior
  /// cuando el usuario elige `coverFromSavings` al crear el mes siguiente.
  DEBT_COVERAGE
  /// Depósito ad-hoc: el usuario (o la IA) declara que mete plata a ahorro
  /// fuera del flujo del mes. Editable y borrable.
  MANUAL_DEPOSIT
  /// Retiro ad-hoc: el usuario (o la IA) saca plata de ahorro por una razón
  /// que no es cubrir deuda del mes anterior. Editable y borrable.
  MANUAL_WITHDRAWAL
}

/// Estado de una billetera de evento.
/// - `OPEN`: el usuario sigue cargando gastos. Cada `MonthExpenseLine.eventId`
///   asociado vive en su `MonthRecord` por `occurredOn`.
/// - `CLOSED`: el evento se cerró. Si `attributionMode = LUMP_SUM` y hay
///   `attributionMonthId`, las líneas se rebucketaron a ese mes.
enum EventStatus {
  OPEN
  CLOSED
}

/// Cómo se imputan los gastos de un evento que cruza meses.
/// - `BY_DATE`: cada gasto vive en el mes en que pasó (por `occurredOn`).
/// - `LUMP_SUM`: al cerrar, todas las líneas se mueven al `attributionMonthId`.
enum EventAttributionMode {
  BY_DATE
  LUMP_SUM
}

/// Discriminador de "tipo de cuenta" para soportar el flujo de billeteras de
/// evento compartidas: cuando alguien acepta un share-link sin tener cuenta
/// Clara, creamos un `User(kind = GUEST)` con email sintético que SOLO puede
/// operar el evento al que fue invitado vía Telegram. El upgrade a REGULAR
/// se hace en `/upgrade-guest` (email + password + Terms).
enum UserKind {
  REGULAR
  GUEST
}

/// Rol de un participante dentro de una billetera de evento compartida.
/// El creador del evento siempre tiene una fila con `OWNER`; los invitados
/// (REGULAR o GUEST) tienen `GUEST`. Solo OWNER puede borrar el evento,
/// remover participantes, mintear/revocar share-tokens.
enum EventParticipantRole {
  OWNER
  GUEST
}

enum ExpenseCategory {
  VIVIENDA
  SERVICIOS
  TRANSPORTE
  ALIMENTACION
  SALUD
  EDUCACION
  ENTRETENIMIENTO
  SUSCRIPCIONES
  DEUDAS
  IMPUESTOS
  AHORRO
  REGALOS
  CRYPTO
  STOCK
  OTROS
}

/// Origen / categoría de un ingreso. Espejo del enum `ExpenseCategory` para
/// la pata de ingresos. Lo usamos tanto para plantillas (`Income.category`)
/// como para líneas mensuales (`MonthIncomeLine.category`).
enum IncomeCategory {
  /// Sueldo en relación de dependencia (ingreso recurrente típico).
  SUELDO
  /// Cobros por trabajo independiente / freelance.
  FREELANCE
  /// Ingresos por negocio propio o emprendimiento.
  NEGOCIO
  /// Rendimientos de inversiones (intereses, dividendos, plazos fijos, etc).
  INVERSIONES
  /// Alquileres cobrados.
  ALQUILER
  /// Bonos, aguinaldos, comisiones, premios laborales.
  BONO
  /// Reembolsos (gastos compartidos, devoluciones, ART, prepaga, etc).
  REEMBOLSO
  /// Regalos en plata recibidos.
  REGALO
  /// Cualquier otro ingreso que no entre en el resto.
  OTROS
}

model User {
  id                           String                 @id @default(cuid())
  /// Tipo de cuenta. `REGULAR` es el default para todos los signups normales.
  /// `GUEST` se asigna automáticamente a usuarios creados a partir de un
  /// share-link de evento que aceptan unirse sin tener cuenta previa: solo
  /// pueden operar el evento al que fueron invitados (vía Telegram), no
  /// pueden loguearse a /app, no pueden ver otros datos. El upgrade flip
  /// a `REGULAR` lo hace el endpoint `/api/auth/upgrade-guest` y exige
  /// email + password + acceptedTerms. Los GUEST usan emails sintéticos
  /// del tipo `guest+<id>@guest.clara.local` para no romper el unique de
  /// `email`.
  kind                         UserKind               @default(REGULAR)
  email                        String                 @unique
  /// Null for users who only sign in with OAuth (e.g. Google).
  passwordHash                 String?
  /// Optional display fields synced from OAuth providers (Auth.js).
  name                         String?
  emailVerified                DateTime?
  image                        String?
  accounts                     Account[]
  /// Admin flag: gates access to /admin and the user-management API.
  isAdmin                      Boolean                @default(false)
  /// Soft-disable: when false, blocks login (web + Google) and the agent (chat + Telegram).
  isActive                     Boolean                @default(true)
  /// Per-user daily cap for agent messages (chat web + Telegram combined). Editable by admins.
  dailyAgentMessageLimit       Int                    @default(30)
  monthlyIncome                Decimal                @default(0) @db.Decimal(12, 2)
  /// Pila acumulada de ahorros del usuario (en `primaryCurrency`). Es un
  /// cache denormalizado: el ledger inmutable vive en `SavingsMovement` y
  /// este campo es la suma firmada de todos los movimientos del usuario.
  /// Se mantiene sincronizado dentro de la misma transacción que inserta
  /// el movimiento (ver `recordSavingsMovement` en `src/lib/savings.ts`).
  savings                      Decimal                @default(0) @db.Decimal(12, 2)
  /// ISO 4217 código (3 letras, mayúsculas). Moneda en la que se hacen las
  /// agregaciones (`MonthRecord.income`, totales por banco, balance, etc.).
  /// Las líneas individuales pueden venir en otras monedas y se convierten a
  /// esta vía `MonthExpenseLine.fxRate` + `amountConverted`.
  primaryCurrency              String                 @default("USD")
  /// Marca cuándo el usuario (o el AI en su nombre) confirmó la moneda
  /// principal. Null = todavía no se confirmó; el agente debe preguntarla.
  primaryCurrencyConfirmedAt   DateTime?
  /// Telegram identity once the user has linked the bot to this account. We
  /// key on `telegramUserId` (Telegram's stable numeric id) and remember the
  /// `chat_id` of the private chat so outbound messages don't need a lookup.
  /// `telegramUsername` is informational (it can change at any time).
  telegramUserId               BigInt?                @unique
  telegramUsername             String?
  telegramChatId               BigInt?
  telegramVerifiedAt           DateTime?
  /// One-time code for `t.me/<bot>?start=<code>` — Telegram allows max 64 chars
  /// for `start`, so we cannot use long signed tokens in deep links.
  telegramLinkCode             String?                @unique
  telegramLinkCodeExpires      DateTime?
  /// Proactive daily nudge: when `true` and the user has Telegram linked, the
  /// hourly `/api/cron/daily-nudge` job sends a short AI-composed message at
  /// 20:00 local time (inferred from `country`) if they haven't logged any
  /// expense, income or manual savings movement that day. Default ON because
  /// linking Telegram is itself an explicit opt-in to Clara's outbound
  /// channel; the user can flip this off any time from Settings.
  telegramNudgeEnabled         Boolean                @default(true)
  /// Timestamp of the last daily nudge we sent. Used as a same-local-day
  /// idempotency guard so a cron retry (or a regional edge replay) does not
  /// deliver two nudges. Null when we have never sent one.
  telegramNudgeLastSentAt      DateTime?
  /// Reglas del usuario para el asistente e importaciones (CSV / fotos): qué no importar, categorías, etc.
  expenseImportInstructions    String?
  /// Marca cuándo se mostró por primera vez el mensaje de bienvenida del asistente. Null = todavía no se saludó.
  welcomedAt                   DateTime?
  /// ISO-3166 alpha-2 (2 letras, mayúsculas) del país de residencia capturado
  /// en el wizard de onboarding. Lo usamos para sugerir la moneda principal.
  country                      String?                @db.Char(2)
  /// Motivos por los que el usuario abre Clara (chips multi-select del wizard).
  /// Valores: `personal`, `couple_family`, `freelance`, `business`, `other`.
  /// Puro hint para el agente; no gating de features.
  usageReasons                 String[]               @default([])
  /// Marca cuándo el usuario terminó (o saltó) el wizard de onboarding. Null
  /// = pendiente; el layout de `/app` redirige a `/onboarding` mientras sea
  /// null para nuevos registros y usuarios viejos que nunca lo completaron.
  onboardingCompletedAt        DateTime?
  /// Idioma preferido del usuario para la UI y el agente Clara. Valores
  /// soportados: "es" (rioplatense, default), "en" (English neutral). Lo
  /// escribe la herramienta `setUserLocale` del agente, el endpoint
  /// /api/settings/locale (selector del menú) y el formulario de Settings.
  locale                       String                 @default("es")
  /// Última vez que el usuario fue visto activo (cualquier request autenticado).
  /// Lo actualiza `touchActivity()` como guardia: solo escribe una vez por día
  /// UTC para evitar contention. Lo consume el dashboard de analytics interno.
  lastSeenAt                   DateTime?
  banks                        Bank[]
  expenses                     Expense[]
  incomes                      Income[]
  monthRecords                 MonthRecord[]
  monthExpenseLines            MonthExpenseLine[]
  monthIncomeLines             MonthIncomeLine[]
  telegramMessages             TelegramMessage[]
  webChatMessages              WebChatMessage[]
  agentUsage                   AgentMessageUsage[]
  agentModelUsage              AgentDailyModelUsage[]
  activeDays                   DailyActiveUser[]
  apiTokens                    ApiToken[]
  /// Stripe customer id (lazy: created on first checkout). Optional so
  /// self-hosters / users that never paid never get a customer record.
  stripeCustomerId             String?                @unique
  /// Mirror of Stripe subscription status: "active" | "trialing" | "past_due"
  /// | "canceled" | null. Drives the "Supporter" pill and the settings card.
  subscriptionStatus           String?
  /// End of the current billing period (renews/cancels at this instant).
  /// Surfaced in the settings UI; the webhook keeps it fresh.
  subscriptionCurrentPeriodEnd DateTime?
  donations                    Donation[]
  featureFlagOverrides         FeatureFlagOverride[]
  passkeys                     Passkey[]
  savingsMovements             SavingsMovement[]
  events                       Event[]
  /// Eventos compartidos en los que participa este usuario (incluye los que
  /// creó como `OWNER` y los que aceptó como `GUEST`).
  eventParticipations          EventParticipant[]
  /// Líneas de gasto cuyo `paidByUserId` apunta a este usuario. Distinto de
  /// `monthExpenseLines` (donde `userId` = dueño del evento). Esta relación
  /// existe para que Prisma sepa cómo borrar en cascada cuando se borra el
  /// usuario.
  paidExpenseLines             MonthExpenseLine[]     @relation("PaidByUser")
  /// Share-tokens que este usuario creó para invitar a sus eventos.
  eventShareTokens             EventShareToken[]      @relation("ShareTokenCreator")
  contactMessages              ContactMessage[]
  /// GDPR Art. 7(1) — demonstrable consent. Stamped when the user actively
  /// accepts the current Terms + Privacy version. NULL means the user has
  /// never accepted (legacy account or signup mid-deploy); the `(app)`
  /// layout gate redirects to /accept-terms in that case.
  acceptedTermsAt              DateTime?
  /// Semver-like string of the Terms+Privacy version the user accepted (e.g.
  /// "1.0"). Compared against `CURRENT_TERMS_VERSION` in `src/lib/legal.ts`
  /// to force re-acceptance after a material change to the legal docs.
  acceptedTermsVersion         String?
  /// Soft-delete marker. `null` for active accounts. When the user clicks
  /// "Borrar mi cuenta" we set this to `now()` instead of running
  /// `db.user.delete()`: the (app) layout redirects them to
  /// `/account/restore`, every mutating surface (api-token verification,
  /// agent quota, Telegram daily-nudge cron) refuses them, and the
  /// `/api/cron/account-purge` cron hard-deletes anything older than
  /// `ACCOUNT_DELETION_GRACE_DAYS` (30) once per day. Restoring is just
  /// clearing the column; the cron's `WHERE deletedAt < cutoff` is atomic
  /// so a restore that happens before the cron tick wins the race.
  deletedAt                    DateTime?
  /// Bitmask of soft-delete reminder emails already dispatched. Bit 0 is
  /// the T-7 reminder, bit 1 is the T-1 reminder. The daily purge cron
  /// reads this to keep reminders idempotent across runs (we don't want a
  /// missed cron tick to spam the user once it catches up). Cleared
  /// automatically when `deletedAt` is reset by a restore.
  deletionRemindersSent        Int                    @default(0)
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt

  // The partial index `User_deletedAt_idx` ON "User"("deletedAt")
  // WHERE "deletedAt" IS NOT NULL is created in
  // `20260502240000_account_soft_delete` because Prisma cannot express
  // partial indexes; the cron's `WHERE deletedAt < cutoff` scan relies on
  // it without bloating writes for the 99.9% active rows.
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// `Session` and `VerificationToken` were removed in migration
// `20260428220000_drop_unused_authjs_tables`: `session.strategy === "jwt"` in
// `src/lib/auth.ts` means NextAuth never reads/writes them.

/// One row per user per UTC day on which the user had any authenticated
/// activity (page visit, API call, login). Powers DAU/WAU/MAU on the admin
/// analytics dashboard. Insert is gated by `User.lastSeenAt` so the upsert
/// only fires the first time the user is seen each day.
model DailyActiveUser {
  id        String   @id @default(cuid())
  userId    String
  day       DateTime @db.Date
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
}

/// Per-user, per-day, per-model breakdown of agent calls. Lives alongside
/// `AgentMessageUsage` (which gates the daily quota and stays untouched);
/// this one only feeds the admin analytics page so we can split usage and
/// estimated cost by model. Best-effort: failures don't affect the user.
model AgentDailyModelUsage {
  id           String   @id @default(cuid())
  userId       String
  day          DateTime @db.Date
  /// Model identifier as passed to the AI SDK gateway, e.g. `openai/gpt-5.4`.
  model        String
  count        Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt

  @@unique([userId, day, model])
  @@index([day])
  @@index([model])
}

/// Daily counter (UTC) of agent messages per user. `count` is the hard-limit
/// against `User.dailyAgentMessageLimit`; tokens are informational only and
/// surfaced in the admin panel so admins can tune limits per user.
model AgentMessageUsage {
  id           String   @id @default(cuid())
  userId       String
  day          DateTime @db.Date
  count        Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId])
}

/// Conversation history for the Telegram channel.
/// We keep `chatId` and `isGroup` so a future "Clara in groups" feature can
/// share the same table. Today the webhook only stores rows for private 1:1
/// chats; group threads are dropped on the floor.
model TelegramMessage {
  id                String   @id @default(cuid())
  userId            String
  role              String // "user" | "assistant"
  text              String
  chatId            BigInt
  isGroup           Boolean  @default(false)
  telegramMessageId BigInt?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([chatId])
}

/// Conversation history for the web chat (`/app`). We persist the full
/// `UIMessage.parts` array (`text`, `file`, `tool-*`, `dynamic-tool`) as JSON
/// so the bubbles re-render identically when the user comes back later
/// (including charts and image attachments). Separate from
/// `TelegramMessage` because that table only stores plain text per channel
/// turn.
model WebChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // "user" | "assistant"
  parts     Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Bank {
  id                String             @id @default(cuid())
  userId            String
  name              String
  color             String?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  incomes           Income[]
  monthExpenseLines MonthExpenseLine[]
  monthIncomeLines  MonthIncomeLine[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([userId, name])
}

// Expense template (definitions); month-specific copies live in MonthExpenseLine.
model Expense {
  id          String             @id @default(cuid())
  userId      String
  bankId      String
  name        String
  amount      Decimal            @db.Decimal(12, 2)
  isRecurring Boolean            @default(true)
  startMonth  DateTime
  endMonth    DateTime?
  category    ExpenseCategory    @default(OTROS)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank        Bank               @relation(fields: [bankId], references: [id], onDelete: Restrict)
  monthLines  MonthExpenseLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MonthRecord {
  id                 String             @id @default(cuid())
  userId             String
  month              DateTime
  /// @deprecated Total de ingreso del mes. Antes era el único campo de ingreso;
  /// ahora la fuente de verdad son las líneas (`MonthIncomeLine`) y se calcula
  /// como `SUM(amountConverted WHERE received)`. La columna queda en la tabla
  /// para no romper queries en una sola release y se elimina en N+1. Nuevos
  /// callers NO deben leer ni escribir este campo.
  income             Decimal            @default(0) @db.Decimal(12, 2)
  /// Sobrante del mes anterior incorporado a este mes cuando el usuario eligió
  /// "sumar al ingreso". Se mantiene en columna aparte (en lugar de inflar
  /// `income`) para que la UI pueda mostrarlo desglosado y para no perderlo si
  /// el usuario edita el ingreso después. Está en `User.primaryCurrency`.
  carryoverFromPrev  Decimal            @default(0) @db.Decimal(12, 2)
  /// Marca cuándo el usuario decidió qué hacer con el sobrante del mes anterior
  /// (sumarlo al ingreso o dejarlo aparte como ahorros). Null = todavía no se
  /// preguntó/decidió, así que la UI / Clara deben mostrar el prompt.
  carryoverDecidedAt DateTime?
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines              MonthExpenseLine[]
  incomeLines        MonthIncomeLine[]
  /// Movimientos de la pila de ahorros vinculados a este mes (aporte mensual,
  /// derivación de sobrante, cobertura de deuda). Borrarlos al borrar el mes
  /// rompería el ledger; usamos `onDelete: SetNull` en la relación inversa.
  savingsMovements   SavingsMovement[]
  /// Eventos cuyos gastos se imputaron a este mes en modo `LUMP_SUM`. Cuando
  /// se borra el mes, el evento queda con `attributionMonthId = NULL` para
  /// preservar la trazabilidad (ver `Event.attributionMonth`).
  attributedEvents   Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId])
}

/// Billetera de evento — agrupa gastos durante un rango de fechas (ej. un
/// viaje, una boda, un cumpleaños). Mientras `status = OPEN`, los
/// `MonthExpenseLine.eventId` viven en su `MonthRecord` por `occurredOn`.
/// Al cerrar con `attributionMode = LUMP_SUM`, todas las líneas se rebucketan
/// al `attributionMonthId` (preservando `occurredOn` para auditoría — el
/// índice de dedupe no incluye `monthRecordId`, así que no se rompe).
///
/// Reglas:
/// - `endDate` opcional: un evento sin fecha de fin queda "abierto" (ej. un
///   proyecto que dura indefinido). Para auto-tagging la IA usa
///   `[startDate, endDate ?? +∞]`.
/// - Solo se puede tener `attributionMonthId` cuando `status = CLOSED` y
///   `attributionMode = LUMP_SUM`. Cuando se reabre, se pone a NULL y las
///   líneas se vuelven a rebucketar a su mes real por `occurredOn`.
model Event {
  id                 String               @id @default(cuid())
  userId             String
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  /// Hex `#rrggbb` opcional para el dot del row colapsable en el dashboard.
  color              String?
  /// Inicio del rango de auto-tagging (UTC, sin hora).
  startDate          DateTime             @db.Date
  /// Fin del rango (inclusive). Null = abierto (sin tope superior).
  endDate            DateTime?            @db.Date
  status             EventStatus          @default(OPEN)
  attributionMode    EventAttributionMode @default(LUMP_SUM)
  /// Mes destino para `LUMP_SUM`. Null mientras `status = OPEN` o
  /// `attributionMode = BY_DATE`. Si se borra el mes destino,
  /// `onDelete: SetNull` deja el evento sin destino y la UI lo muestra como
  /// "sin asignar" (no afecta a las líneas, que ya fueron movidas).
  attributionMonthId String?
  attributionMonth   MonthRecord?         @relation(fields: [attributionMonthId], references: [id], onDelete: SetNull)
  closedAt           DateTime?
  lines              MonthExpenseLine[]
  /// Participantes activos + removidos del evento. El owner siempre tiene
  /// una fila con `role = OWNER`, los invitados con `role = GUEST`. La
  /// migración hace backfill para los eventos existentes.
  participants       EventParticipant[]
  /// Share-tokens emitidos para invitar a este evento (stateful para poder
  /// revocar y observar uso).
  shareTokens        EventShareToken[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([userId, status])
  @@index([attributionMonthId])
}

/// Join entre `User` y `Event` para soportar billeteras de evento compartidas.
/// El owner siempre tiene una fila con `role = OWNER`. Los invitados (REGULAR
/// o GUEST) tienen `role = GUEST`. `removedAt` permite tombstone (sin perder
/// la atribución histórica de líneas que pagó). El `displayName` se snapshotea
/// al momento de unirse así el chat de Telegram puede decir "vos / Marcos /
/// Lucia" sin tener que joinear contra User en cada turno.
model EventParticipant {
  id               String               @id @default(cuid())
  eventId          String
  userId           String
  role             EventParticipantRole
  /// Visible en chat ("vos / Marcos / Lucia"). Snapshot al join, editable
  /// solo via `PATCH` interno si hace falta.
  displayName      String
  /// One-time code corto para `t.me/<bot>?start=<code>` que la share-link
  /// landing genera para los GUEST recién creados. Una vez consumido por
  /// el webhook de Telegram se borra (set null). 64 chars max por límite
  /// de Telegram.
  telegramLinkCode String?              @unique
  joinedAt         DateTime             @default(now())
  removedAt        DateTime?
  event            Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
}

/// Token de share (stateful) para invitar a un evento. Guardamos solo el
/// `sha256(token)` así no podemos reconstruir el token plano si nos roban
/// la base. `revokedAt` permite invalidar al instante. `expiresAt` es
/// obligatorio (default 30 días en código). `lastUsedAt` se actualiza en
/// cada accept para que el owner vea actividad. Un cron periódico borra
/// los expirados (`expiresAt < now() - 30d`).
model EventShareToken {
  id          String    @id @default(cuid())
  eventId     String
  createdById String
  /// `sha256(<base64url-random>)`. Único para detectar colisión y para
  /// el lookup en accept (calculamos el hash del token plano que viene
  /// en la URL y buscamos por igualdad).
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("ShareTokenCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([eventId])
  @@index([createdById])
}

model MonthExpenseLine {
  id              String          @id @default(cuid())
  /// Denormalizado desde `monthRecord.userId` para soportar el índice único
  /// global de deduplicación (un usuario no puede tener dos líneas con la
  /// misma fecha/descripción/monto/moneda). FK con cascade igual que
  /// `MonthRecord.userId`.
  userId          String
  monthRecordId   String
  templateId      String?
  bankId          String
  name            String
  /// Fecha real del gasto (no la del bucket). Para imports CSV: la fecha
  /// que venga en la fila (booking/value date); cuando no haya, HOY (UTC).
  /// Para entradas manuales por chat / foto / formulario: HOY (UTC) salvo
  /// que el usuario indique otra fecha. Solo guardamos la parte de fecha
  /// (sin hora) para que la deduplicación sea determinística entre zonas
  /// horarias.
  occurredOn      DateTime        @db.Date
  /// Monto en la moneda original de la línea (`currency`).
  amount          Decimal         @db.Decimal(12, 2)
  /// ISO 4217 (3 letras, mayúsculas). Moneda en la que el usuario carga el
  /// gasto. Si difiere de `User.primaryCurrency`, guardamos `fxRate` y
  /// `amountConverted` para que las matemáticas vivan en la moneda principal.
  currency        String          @default("USD")
  /// Multiplicador `amount * fxRate = amountConverted`. Vale 1 cuando la
  /// línea ya está en la moneda principal del usuario. Se "congela" al crear
  /// la línea para que las agregaciones sean determinísticas.
  fxRate          Decimal         @default(1) @db.Decimal(20, 10)
  /// Monto pre-calculado en la moneda principal (`User.primaryCurrency`).
  /// Usalo para todos los `sum`/totales; nunca recalcules desde `amount`.
  amountConverted Decimal         @db.Decimal(12, 2)
  category        ExpenseCategory @default(OTROS)
  paid            Boolean         @default(false)
  /// Billetera de evento a la que pertenece la línea. Null = gasto suelto.
  /// `onDelete: SetNull` para que borrar el evento no destruya los gastos.
  eventId         String?
  event           Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// Quién pagó esta línea cuando vive en una billetera de evento compartida
  /// con varios participantes. Null = legado / evento de un solo dueño /
  /// gasto suelto. Cuando el evento tiene >1 participante activo el código
  /// (AI tool + REST) exige este campo para que el reparto del cierre
  /// (`computeSettlement`) sea correcto. `onDelete: SetNull` para que
  /// borrar el usuario no aniquile las líneas (auditoría histórica).
  paidByUserId    String?
  paidByUser      User?           @relation("PaidByUser", fields: [paidByUserId], references: [id], onDelete: SetNull)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthRecord     MonthRecord     @relation(fields: [monthRecordId], references: [id], onDelete: Cascade)
  template        Expense?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  bank            Bank            @relation(fields: [bankId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // El índice único de deduplicación
  // (`userId`, `occurredOn`, lower(trim(regexp_replace(name,...))), `amount`,
  // `currency`) WHERE `templateId` IS NULL se crea con SQL en la migración
  // `20260429140000_expense_dedup` porque Prisma no expresa índices con
  // funciones ni parciales.

  @@index([monthRecordId])
  @@index([userId])
  @@index([eventId])
  @@index([paidByUserId])
}

/// Plantilla de ingreso (recurrente o de un solo mes). Espejo de `Expense`:
/// los ingresos del mes (`MonthIncomeLine`) pueden venir de una plantilla
/// (sueldo, alquiler cobrado, etc.) o ser entradas sueltas (un cobro puntual
/// de freelance). `bankId` es opcional porque, a diferencia de los gastos,
/// muchas veces no importa "en qué cuenta cae" — y el chat-first flow no
/// quiere obligar a elegir banco para registrar un cobro rápido.
model Income {
  id          String            @id @default(cuid())
  userId      String
  bankId      String?
  name        String
  amount      Decimal           @db.Decimal(12, 2)
  /// ISO 4217 (3 letras, mayúsculas). Moneda original de la plantilla. Cuando
  /// se materializa una línea mensual desde la plantilla, si la moneda
  /// principal del usuario difiere, se snapshotea con `fxRate` y
  /// `amountConverted`, igual que en gastos.
  currency    String            @default("USD")
  isRecurring Boolean           @default(true)
  startMonth  DateTime
  endMonth    DateTime?
  category    IncomeCategory    @default(OTROS)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank        Bank?             @relation(fields: [bankId], references: [id], onDelete: SetNull)
  monthLines  MonthIncomeLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Línea de ingreso de un mes. Espejo de `MonthExpenseLine`: cobros que el
/// usuario espera o ya recibió en un mes específico. La fuente de verdad
/// para "cuánto entró este mes" es `SUM(amountConverted WHERE received)`.
/// Las líneas pueden venir de una plantilla (`templateId` set) o ser sueltas
/// (cobro puntual). El campo `received` es el espejo de `paid` en gastos:
/// hasta que la plata cae, queda como "previsto" pero no suma al balance.
model MonthIncomeLine {
  id              String         @id @default(cuid())
  /// Denormalizado desde `monthRecord.userId` para soportar el índice único
  /// global de deduplicación (un usuario no puede tener dos líneas con la
  /// misma fecha/descripción/monto/moneda). FK con cascade igual que
  /// `MonthRecord.userId`.
  userId          String
  monthRecordId   String
  templateId      String?
  /// Cuenta donde cae el cobro. Opcional — el chat-first flow no obliga a
  /// elegir banco para registrar un cobro rápido.
  bankId          String?
  name            String
  /// Fecha real del cobro (no la del bucket). Para entradas manuales por chat
  /// / formulario: HOY (UTC) salvo que el usuario indique otra. Solo
  /// guardamos la parte de fecha (sin hora) para que la deduplicación sea
  /// determinística entre zonas horarias.
  occurredOn      DateTime       @db.Date
  /// Monto en la moneda original de la línea (`currency`).
  amount          Decimal        @db.Decimal(12, 2)
  /// ISO 4217 (3 letras, mayúsculas). Moneda en la que el usuario carga el
  /// cobro. Si difiere de `User.primaryCurrency`, guardamos `fxRate` y
  /// `amountConverted` para que las matemáticas vivan en la moneda principal.
  currency        String         @default("USD")
  /// Multiplicador `amount * fxRate = amountConverted`. Vale 1 cuando la
  /// línea ya está en la moneda principal del usuario. Se "congela" al crear
  /// la línea para que las agregaciones sean determinísticas.
  fxRate          Decimal        @default(1) @db.Decimal(20, 10)
  /// Monto pre-calculado en la moneda principal (`User.primaryCurrency`).
  /// Usalo para todos los `sum`/totales; nunca recalcules desde `amount`.
  amountConverted Decimal        @db.Decimal(12, 2)
  category        IncomeCategory @default(OTROS)
  /// Espejo de `paid` en gastos: `true` cuando la plata ya entró. Hasta que
  /// no esté en `true`, la línea cuenta como "previsto" pero NO suma al
  /// balance ni al `effectiveIncome` del mes.
  received        Boolean        @default(false)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthRecord     MonthRecord    @relation(fields: [monthRecordId], references: [id], onDelete: Cascade)
  template        Income?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  bank            Bank?          @relation(fields: [bankId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // El índice único de deduplicación
  // (`userId`, `occurredOn`, lower(btrim(regexp_replace(name,...))), `amount`,
  // `currency`) WHERE `templateId` IS NULL se crea con SQL en la migración
  // de income porque Prisma no expresa índices con funciones ni parciales.

  @@index([monthRecordId])
  @@index([userId])
}

/// One-off donation made via Stripe Checkout. Persisted from the
/// `checkout.session.completed` webhook for receipts and for the future
/// "thanks" page. Donations are non-refundable; no subscription side-effect.
model Donation {
  id                    String   @id @default(cuid())
  userId                String
  /// Stripe Checkout session id. Unique so webhook replays are idempotent.
  stripeSessionId       String   @unique
  /// PaymentIntent id from Stripe (kept for support/refund lookups).
  stripePaymentIntentId String?
  /// Amount in the smallest currency unit (cents for EUR).
  amountCents           Int
  /// ISO 4217 (3 letters). Today always "EUR"; kept as a column so we
  /// don't paint ourselves into a corner if multi-currency lands later.
  currency              String   @default("EUR")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())

  @@index([userId])
}

/// Global, admin-toggleable feature flag. Default state lives in the
/// `FEATURE_FLAGS` registry in `src/lib/feature-flags.ts`; rows here only
/// exist once an admin has flipped a flag at least once. `updatedBy` is
/// the admin user id (audit trail).
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// Per-user override for a feature flag. When present, takes precedence
/// over the global value. Used to dogfood new flags as admin-only first.
model FeatureFlagOverride {
  id        String   @id @default(cuid())
  userId    String
  key       String
  enabled   Boolean
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([key])
}

/// Ledger inmutable de movimientos de la pila global de ahorros del usuario.
/// La columna `User.savings` es un cache denormalizado de `SUM(amount)` de
/// los movimientos de cada usuario; se mantiene en sincronía dentro de la
/// misma transacción que inserta/borra movimientos (`src/lib/savings.ts`).
///
/// Reglas:
/// - `amount` es FIRMADO: positivo para depósitos (entran a la pila),
///   negativo para retiros / cobertura de deuda.
/// - `monthRecordId` es opcional. Movimientos manuales pueden no estar
///   ligados a un mes; los movimientos derivados del flujo de cierre de mes
///   (CARRYOVER_DEPOSIT, MONTHLY_CONTRIBUTION, DEBT_COVERAGE) están ligados
///   al mes correspondiente para trazabilidad.
/// - Hay a lo sumo un MONTHLY_CONTRIBUTION y un CARRYOVER_DEPOSIT por mes
///   (índice único `(userId, monthRecordId, kind)`). Permite reemplazos
///   re-creando la fila tras borrar la anterior dentro de una transacción.
model SavingsMovement {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthRecordId String?
  monthRecord   MonthRecord?        @relation(fields: [monthRecordId], references: [id], onDelete: SetNull)
  kind          SavingsMovementKind
  /// Monto firmado en `User.primaryCurrency`. Positivo = entra a la pila;
  /// negativo = sale (retiro o cobertura de deuda).
  amount        Decimal             @db.Decimal(12, 2)
  /// Snapshot de la moneda principal del usuario al momento del movimiento.
  /// Si el usuario cambia de moneda principal después, las cuentas viejas
  /// no se reconvierten — quedan documentadas en su moneda original.
  currency      String
  note          String?
  /// Fecha "lógica" del movimiento (UTC, sin hora). Default: hoy. Para
  /// MONTHLY_CONTRIBUTION conviene usar el primer día del mes asociado.
  occurredOn    DateTime            @db.Date
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  /// Garantiza un solo MONTHLY_CONTRIBUTION y un solo CARRYOVER_DEPOSIT por
  /// (usuario, mes). Movimientos manuales (MANUAL_*) y DEBT_COVERAGE pueden
  /// no estar asociados a un mes (`monthRecordId NULL`); el índice único
  /// no aplica con NULLs en Postgres, así que no los limita.
  @@unique([userId, monthRecordId, kind], name: "uq_savings_one_per_kind_per_month")
  @@index([userId, occurredOn])
  @@index([userId, monthRecordId])
}

/// WebAuthn / FIDO2 credential ("passkey") registered by a user. Sign-in
/// happens through the `Passkey` CredentialsProvider in `src/lib/auth.ts`,
/// which calls `verifyAuthenticationResponse` from `@simplewebauthn/server`
/// using the public key persisted here. We store the credential id in
/// base64url, exactly the way the WebAuthn API surfaces it on the client,
/// so the lookup is a direct primary-key hit.
model Passkey {
  /// Base64URL-encoded credential id (WebAuthn `rawId`). Unique per browser
  /// + authenticator combo, so it doubles as the primary key.
  id                  String    @id
  userId              String
  /// Base64URL-encoded COSE public key returned by `verifyRegistrationResponse`.
  credentialPublicKey String
  /// Authenticator signature counter; bumped on every successful auth and
  /// monotonically increasing. A regression here flags a cloned authenticator.
  counter             Int       @default(0)
  /// "singleDevice" (platform-bound) or "multiDevice" (synced via iCloud /
  /// Google Password Manager / Bitwarden / 1Password).
  deviceType          String
  /// `true` when the credential is backed up to a passkey provider, so we can
  /// warn the user if they're about to delete their only platform passkey.
  backedUp            Boolean   @default(false)
  /// Subset of {"usb","nfc","ble","internal","hybrid","cable","smart-card"}.
  transports          String[]  @default([])
  /// User-visible label ("MacBook Touch ID", "iPhone", "YubiKey 5C").
  name                String
  lastUsedAt          DateTime?
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Idempotency log for Stripe webhook events. Inserted by the webhook
/// handler **before** applying side effects; a duplicate event id makes
/// the insert fail (P2002) and the handler returns 200 without re-running.
model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([type])
}

/// Personal Access Token (bearer) used by the user-scoped MCP server at
/// `/api/mcp/user`. We persist a sha-256 hash of the token (never the
/// plaintext) plus a short prefix so the user can identify the token in the
/// settings UI without ever seeing the secret again after creation.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  /// Human-readable label set by the user ("Claude Desktop", "Cursor", etc.).
  name       String
  /// Hex sha-256 hash of the token. The plaintext is shown once, on creation.
  tokenHash  String    @unique
  /// First 12 chars of the token (e.g. `ada_pat_3f8a`) for UI display.
  prefix     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

// Removed: `TtsAudioCache` was an old workaround for serving OpenAI TTS
// MP3 to a third-party service. Migration `20260428220500_drop_tts_audio_cache`
// drops the table; we now upload TTS to Vercel Blob (`src/lib/blob/tts.ts`)
// and serve the signed URL directly to the web client.

/// Razón por la que alguien escribe al formulario público de contacto.
/// La elegimos al recibir el mensaje para poder priorizar la bandeja del
/// admin: PRIVACY (GDPR / DSAR) y ABUSE tienen SLA más corto que el resto.
enum ContactMessageKind {
  PRIVACY
  ABUSE
  BUG
  GENERAL
}

/// Mensajes que llegan desde `/contact` (formulario público) o desde el
/// banner "necesitás ayuda" del app. La bandeja vive en `/admin/contact`.
///
/// Privacidad del propio formulario:
/// - `name` y `email` los carga quien escribe; pueden no coincidir con
///   ningún `User`.
/// - `userId` queda set sólo si la sesión está activa al enviar.
/// - `ip` y `userAgent` se guardan para anti-abuso y se purgan a los 90
///   días (ver `scripts/purge-contact-metadata.ts`) o cuando el mensaje se
///   archiva, lo que ocurra primero.
/// - El admin puede marcar `readAt`, `repliedAt` y `archivedAt` desde la
///   bandeja sin tocar el cuerpo del mensaje.
model ContactMessage {
  id         String             @id @default(cuid())
  kind       ContactMessageKind @default(GENERAL)
  name       String
  email      String
  body       String             @db.Text
  userId     String?
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip         String?
  userAgent  String?            @db.Text
  readAt     DateTime?
  repliedAt  DateTime?
  archivedAt DateTime?
  createdAt  DateTime           @default(now())

  @@index([createdAt])
  @@index([kind])
  @@index([userId])
}
