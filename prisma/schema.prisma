generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ExpenseCategory {
  VIVIENDA
  SERVICIOS
  TRANSPORTE
  ALIMENTACION
  SALUD
  EDUCACION
  ENTRETENIMIENTO
  SUSCRIPCIONES
  DEUDAS
  IMPUESTOS
  AHORRO
  REGALOS
  OTROS
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  monthlyIncome Decimal        @default(0) @db.Decimal(12, 2)
  banks         Bank[]
  expenses      Expense[]
  monthRecords  MonthRecord[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Bank {
  id                String              @id @default(cuid())
  userId            String
  name              String
  color             String?
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  monthExpenseLines MonthExpenseLine[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([userId, name])
}

// Expense template (definitions); month-specific copies live in MonthExpenseLine.
model Expense {
  id          String          @id @default(cuid())
  userId      String
  bankId      String
  name        String
  amount      Decimal         @db.Decimal(12, 2)
  isRecurring Boolean         @default(true)
  startMonth  DateTime
  endMonth    DateTime?
  category    ExpenseCategory @default(OTROS)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank        Bank            @relation(fields: [bankId], references: [id], onDelete: Restrict)
  monthLines  MonthExpenseLine[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model MonthRecord {
  id        String             @id @default(cuid())
  userId    String
  month     DateTime
  income    Decimal            @default(0) @db.Decimal(12, 2)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines     MonthExpenseLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId])
}

model MonthExpenseLine {
  id            String          @id @default(cuid())
  monthRecordId String
  templateId    String?
  bankId        String
  name          String
  amount        Decimal         @db.Decimal(12, 2)
  category      ExpenseCategory @default(OTROS)
  paid          Boolean         @default(false)
  monthRecord   MonthRecord     @relation(fields: [monthRecordId], references: [id], onDelete: Cascade)
  template      Expense?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  bank          Bank            @relation(fields: [bankId], references: [id], onDelete: Restrict)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([monthRecordId])
}
