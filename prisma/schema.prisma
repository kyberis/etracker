generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Tipo de movimiento en la pila global de ahorros (`User.savings`).
/// La pila es la suma firmada de todos los `SavingsMovement` del usuario.
enum SavingsMovementKind {
  /// Aporte mensual informativo: el usuario declara cuánto dedica a ahorro
  /// para un mes dado. NO afecta el balance del mes (no se descuenta de
  /// `MonthRecord.income` ni aparece como `MonthExpenseLine`); solo suma a
  /// la pila. Único por (`userId`, `monthRecordId`).
  MONTHLY_CONTRIBUTION
  /// Sobrante del mes anterior derivado a ahorros via `applyPrevMonthLeftoverDecision`
  /// con `mode = "setAside"`. Único por (`userId`, `monthRecordId`).
  CARRYOVER_DEPOSIT
  /// Salida (firmado negativo) que cubre el saldo negativo del mes anterior
  /// cuando el usuario elige `coverFromSavings` al crear el mes siguiente.
  DEBT_COVERAGE
  /// Depósito ad-hoc: el usuario (o la IA) declara que mete plata a ahorro
  /// fuera del flujo del mes. Editable y borrable.
  MANUAL_DEPOSIT
  /// Retiro ad-hoc: el usuario (o la IA) saca plata de ahorro por una razón
  /// que no es cubrir deuda del mes anterior. Editable y borrable.
  MANUAL_WITHDRAWAL
}

enum ExpenseCategory {
  VIVIENDA
  SERVICIOS
  TRANSPORTE
  ALIMENTACION
  SALUD
  EDUCACION
  ENTRETENIMIENTO
  SUSCRIPCIONES
  DEUDAS
  IMPUESTOS
  AHORRO
  REGALOS
  CRYPTO
  STOCK
  OTROS
}

model User {
  id                       String              @id @default(cuid())
  email                    String              @unique
  /// Null for users who only sign in with OAuth (e.g. Google).
  passwordHash             String?
  /// Optional display fields synced from OAuth providers (Auth.js).
  name                     String?
  emailVerified            DateTime?
  image                    String?
  accounts                 Account[]
  /// Admin flag: gates access to /admin and the user-management API.
  isAdmin                  Boolean             @default(false)
  /// Soft-disable: when false, blocks login (web + Google) and the agent (chat + Telegram).
  isActive                 Boolean             @default(true)
  /// Per-user daily cap for agent messages (chat web + Telegram combined). Editable by admins.
  dailyAgentMessageLimit   Int                 @default(30)
  monthlyIncome            Decimal             @default(0) @db.Decimal(12, 2)
  /// Pila acumulada de ahorros del usuario (en `primaryCurrency`). Es un
  /// cache denormalizado: el ledger inmutable vive en `SavingsMovement` y
  /// este campo es la suma firmada de todos los movimientos del usuario.
  /// Se mantiene sincronizado dentro de la misma transacción que inserta
  /// el movimiento (ver `recordSavingsMovement` en `src/lib/savings.ts`).
  savings                  Decimal             @default(0) @db.Decimal(12, 2)
  /// ISO 4217 código (3 letras, mayúsculas). Moneda en la que se hacen las
  /// agregaciones (`MonthRecord.income`, totales por banco, balance, etc.).
  /// Las líneas individuales pueden venir en otras monedas y se convierten a
  /// esta vía `MonthExpenseLine.fxRate` + `amountConverted`.
  primaryCurrency          String              @default("USD")
  /// Marca cuándo el usuario (o el AI en su nombre) confirmó la moneda
  /// principal. Null = todavía no se confirmó; el agente debe preguntarla.
  primaryCurrencyConfirmedAt DateTime?
  /// Telegram identity once the user has linked the bot to this account. We
  /// key on `telegramUserId` (Telegram's stable numeric id) and remember the
  /// `chat_id` of the private chat so outbound messages don't need a lookup.
  /// `telegramUsername` is informational (it can change at any time).
  telegramUserId           BigInt?             @unique
  telegramUsername         String?
  telegramChatId           BigInt?
  telegramVerifiedAt       DateTime?
  /// One-time code for `t.me/<bot>?start=<code>` — Telegram allows max 64 chars
  /// for `start`, so we cannot use long signed tokens in deep links.
  telegramLinkCode         String?             @unique
  telegramLinkCodeExpires  DateTime?
  /// Reglas del usuario para el asistente e importaciones (CSV / fotos): qué no importar, categorías, etc.
  expenseImportInstructions String?
  /// Marca cuándo se mostró por primera vez el mensaje de bienvenida del asistente. Null = todavía no se saludó.
  welcomedAt               DateTime?
  /// ISO-3166 alpha-2 (2 letras, mayúsculas) del país de residencia capturado
  /// en el wizard de onboarding. Lo usamos para sugerir la moneda principal.
  country                  String?             @db.Char(2)
  /// Motivos por los que el usuario abre Clara (chips multi-select del wizard).
  /// Valores: `personal`, `couple_family`, `freelance`, `business`, `other`.
  /// Puro hint para el agente; no gating de features.
  usageReasons             String[]            @default([])
  /// Marca cuándo el usuario terminó (o saltó) el wizard de onboarding. Null
  /// = pendiente; el layout de `/app` redirige a `/onboarding` mientras sea
  /// null para nuevos registros y usuarios viejos que nunca lo completaron.
  onboardingCompletedAt    DateTime?
  /// Idioma preferido del usuario para la UI y el agente Clara. Valores
  /// soportados: "es" (rioplatense, default), "en" (English neutral). Lo
  /// escribe la herramienta `setUserLocale` del agente, el endpoint
  /// /api/settings/locale (selector del menú) y el formulario de Settings.
  locale                   String              @default("es")
  /// Última vez que el usuario fue visto activo (cualquier request autenticado).
  /// Lo actualiza `touchActivity()` como guardia: solo escribe una vez por día
  /// UTC para evitar contention. Lo consume el dashboard de analytics interno.
  lastSeenAt               DateTime?
  banks                    Bank[]
  expenses                 Expense[]
  monthRecords             MonthRecord[]
  monthExpenseLines        MonthExpenseLine[]
  telegramMessages         TelegramMessage[]
  webChatMessages          WebChatMessage[]
  agentUsage               AgentMessageUsage[]
  agentModelUsage          AgentDailyModelUsage[]
  activeDays               DailyActiveUser[]
  apiTokens                ApiToken[]
  /// Stripe customer id (lazy: created on first checkout). Optional so
  /// self-hosters / users that never paid never get a customer record.
  stripeCustomerId         String?             @unique
  /// Mirror of Stripe subscription status: "active" | "trialing" | "past_due"
  /// | "canceled" | null. Drives the "Supporter" pill and the settings card.
  subscriptionStatus       String?
  /// End of the current billing period (renews/cancels at this instant).
  /// Surfaced in the settings UI; the webhook keeps it fresh.
  subscriptionCurrentPeriodEnd DateTime?
  donations                Donation[]
  featureFlagOverrides     FeatureFlagOverride[]
  passkeys                 Passkey[]
  savingsMovements         SavingsMovement[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// `Session` and `VerificationToken` were removed in migration
// `20260428220000_drop_unused_authjs_tables`: `session.strategy === "jwt"` in
// `src/lib/auth.ts` means NextAuth never reads/writes them.

/// One row per user per UTC day on which the user had any authenticated
/// activity (page visit, API call, login). Powers DAU/WAU/MAU on the admin
/// analytics dashboard. Insert is gated by `User.lastSeenAt` so the upsert
/// only fires the first time the user is seen each day.
model DailyActiveUser {
  id        String   @id @default(cuid())
  userId    String
  day       DateTime @db.Date
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
}

/// Per-user, per-day, per-model breakdown of agent calls. Lives alongside
/// `AgentMessageUsage` (which gates the daily quota and stays untouched);
/// this one only feeds the admin analytics page so we can split usage and
/// estimated cost by model. Best-effort: failures don't affect the user.
model AgentDailyModelUsage {
  id           String   @id @default(cuid())
  userId       String
  day          DateTime @db.Date
  /// Model identifier as passed to the AI SDK gateway, e.g. `openai/gpt-5.4`.
  model        String
  count        Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt

  @@unique([userId, day, model])
  @@index([day])
  @@index([model])
}

/// Daily counter (UTC) of agent messages per user. `count` is the hard-limit
/// against `User.dailyAgentMessageLimit`; tokens are informational only and
/// surfaced in the admin panel so admins can tune limits per user.
model AgentMessageUsage {
  id           String   @id @default(cuid())
  userId       String
  day          DateTime @db.Date
  count        Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId])
}

/// Conversation history for the Telegram channel.
/// We keep `chatId` and `isGroup` so a future "Clara in groups" feature can
/// share the same table. Today the webhook only stores rows for private 1:1
/// chats; group threads are dropped on the floor.
model TelegramMessage {
  id                String   @id @default(cuid())
  userId            String
  role              String   // "user" | "assistant"
  text              String
  chatId            BigInt
  isGroup           Boolean  @default(false)
  telegramMessageId BigInt?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([chatId])
}

/// Conversation history for the web chat (`/app`). We persist the full
/// `UIMessage.parts` array (`text`, `file`, `tool-*`, `dynamic-tool`) as JSON
/// so the bubbles re-render identically when the user comes back later
/// (including charts and image attachments). Separate from
/// `TelegramMessage` because that table only stores plain text per channel
/// turn.
model WebChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // "user" | "assistant"
  parts     Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Bank {
  id                String              @id @default(cuid())
  userId            String
  name              String
  color             String?
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  monthExpenseLines MonthExpenseLine[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([userId, name])
}

// Expense template (definitions); month-specific copies live in MonthExpenseLine.
model Expense {
  id          String          @id @default(cuid())
  userId      String
  bankId      String
  name        String
  amount      Decimal         @db.Decimal(12, 2)
  isRecurring Boolean         @default(true)
  startMonth  DateTime
  endMonth    DateTime?
  category    ExpenseCategory @default(OTROS)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank        Bank            @relation(fields: [bankId], references: [id], onDelete: Restrict)
  monthLines  MonthExpenseLine[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model MonthRecord {
  id        String             @id @default(cuid())
  userId    String
  month     DateTime
  income    Decimal            @default(0) @db.Decimal(12, 2)
  /// Sobrante del mes anterior incorporado a este mes cuando el usuario eligió
  /// "sumar al ingreso". Se mantiene en columna aparte (en lugar de inflar
  /// `income`) para que la UI pueda mostrarlo desglosado y para no perderlo si
  /// el usuario edita el ingreso después. Está en `User.primaryCurrency`.
  carryoverFromPrev   Decimal   @default(0) @db.Decimal(12, 2)
  /// Marca cuándo el usuario decidió qué hacer con el sobrante del mes anterior
  /// (sumarlo al ingreso o dejarlo aparte como ahorros). Null = todavía no se
  /// preguntó/decidió, así que la UI/Ada deben mostrar el prompt.
  carryoverDecidedAt  DateTime?
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines     MonthExpenseLine[]
  /// Movimientos de la pila de ahorros vinculados a este mes (aporte mensual,
  /// derivación de sobrante, cobertura de deuda). Borrarlos al borrar el mes
  /// rompería el ledger; usamos `onDelete: SetNull` en la relación inversa.
  savingsMovements SavingsMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId])
}

model MonthExpenseLine {
  id            String          @id @default(cuid())
  /// Denormalizado desde `monthRecord.userId` para soportar el índice único
  /// global de deduplicación (un usuario no puede tener dos líneas con la
  /// misma fecha/descripción/monto/moneda). FK con cascade igual que
  /// `MonthRecord.userId`.
  userId        String
  monthRecordId String
  templateId    String?
  bankId        String
  name          String
  /// Fecha real del gasto (no la del bucket). Para imports CSV: la fecha
  /// que venga en la fila (booking/value date); cuando no haya, HOY (UTC).
  /// Para entradas manuales por chat / foto / formulario: HOY (UTC) salvo
  /// que el usuario indique otra fecha. Solo guardamos la parte de fecha
  /// (sin hora) para que la deduplicación sea determinística entre zonas
  /// horarias.
  occurredOn    DateTime        @db.Date
  /// Monto en la moneda original de la línea (`currency`).
  amount        Decimal         @db.Decimal(12, 2)
  /// ISO 4217 (3 letras, mayúsculas). Moneda en la que el usuario carga el
  /// gasto. Si difiere de `User.primaryCurrency`, guardamos `fxRate` y
  /// `amountConverted` para que las matemáticas vivan en la moneda principal.
  currency      String          @default("USD")
  /// Multiplicador `amount * fxRate = amountConverted`. Vale 1 cuando la
  /// línea ya está en la moneda principal del usuario. Se "congela" al crear
  /// la línea para que las agregaciones sean determinísticas.
  fxRate        Decimal         @default(1) @db.Decimal(20, 10)
  /// Monto pre-calculado en la moneda principal (`User.primaryCurrency`).
  /// Usalo para todos los `sum`/totales; nunca recalcules desde `amount`.
  amountConverted Decimal       @db.Decimal(12, 2)
  category      ExpenseCategory @default(OTROS)
  paid          Boolean         @default(false)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthRecord   MonthRecord     @relation(fields: [monthRecordId], references: [id], onDelete: Cascade)
  template      Expense?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  bank          Bank            @relation(fields: [bankId], references: [id], onDelete: Restrict)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([monthRecordId])
  @@index([userId])
  // El índice único de deduplicación
  // (`userId`, `occurredOn`, lower(trim(regexp_replace(name,...))), `amount`,
  // `currency`) WHERE `templateId` IS NULL se crea con SQL en la migración
  // `20260429140000_expense_dedup` porque Prisma no expresa índices con
  // funciones ni parciales.
}

/// One-off donation made via Stripe Checkout. Persisted from the
/// `checkout.session.completed` webhook for receipts and for the future
/// "thanks" page. Donations are non-refundable; no subscription side-effect.
model Donation {
  id                    String   @id @default(cuid())
  userId                String
  /// Stripe Checkout session id. Unique so webhook replays are idempotent.
  stripeSessionId       String   @unique
  /// PaymentIntent id from Stripe (kept for support/refund lookups).
  stripePaymentIntentId String?
  /// Amount in the smallest currency unit (cents for EUR).
  amountCents           Int
  /// ISO 4217 (3 letters). Today always "EUR"; kept as a column so we
  /// don't paint ourselves into a corner if multi-currency lands later.
  currency              String   @default("EUR")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())

  @@index([userId])
}

/// Global, admin-toggleable feature flag. Default state lives in the
/// `FEATURE_FLAGS` registry in `src/lib/feature-flags.ts`; rows here only
/// exist once an admin has flipped a flag at least once. `updatedBy` is
/// the admin user id (audit trail).
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// Per-user override for a feature flag. When present, takes precedence
/// over the global value. Used to dogfood new flags as admin-only first.
model FeatureFlagOverride {
  id        String   @id @default(cuid())
  userId    String
  key       String
  enabled   Boolean
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([key])
}

/// Ledger inmutable de movimientos de la pila global de ahorros del usuario.
/// La columna `User.savings` es un cache denormalizado de `SUM(amount)` de
/// los movimientos de cada usuario; se mantiene en sincronía dentro de la
/// misma transacción que inserta/borra movimientos (`src/lib/savings.ts`).
///
/// Reglas:
/// - `amount` es FIRMADO: positivo para depósitos (entran a la pila),
///   negativo para retiros / cobertura de deuda.
/// - `monthRecordId` es opcional. Movimientos manuales pueden no estar
///   ligados a un mes; los movimientos derivados del flujo de cierre de mes
///   (CARRYOVER_DEPOSIT, MONTHLY_CONTRIBUTION, DEBT_COVERAGE) están ligados
///   al mes correspondiente para trazabilidad.
/// - Hay a lo sumo un MONTHLY_CONTRIBUTION y un CARRYOVER_DEPOSIT por mes
///   (índice único `(userId, monthRecordId, kind)`). Permite reemplazos
///   re-creando la fila tras borrar la anterior dentro de una transacción.
model SavingsMovement {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthRecordId String?
  monthRecord   MonthRecord?        @relation(fields: [monthRecordId], references: [id], onDelete: SetNull)
  kind          SavingsMovementKind
  /// Monto firmado en `User.primaryCurrency`. Positivo = entra a la pila;
  /// negativo = sale (retiro o cobertura de deuda).
  amount        Decimal             @db.Decimal(12, 2)
  /// Snapshot de la moneda principal del usuario al momento del movimiento.
  /// Si el usuario cambia de moneda principal después, las cuentas viejas
  /// no se reconvierten — quedan documentadas en su moneda original.
  currency      String
  note          String?
  /// Fecha "lógica" del movimiento (UTC, sin hora). Default: hoy. Para
  /// MONTHLY_CONTRIBUTION conviene usar el primer día del mes asociado.
  occurredOn    DateTime            @db.Date
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, occurredOn])
  @@index([userId, monthRecordId])
  /// Garantiza un solo MONTHLY_CONTRIBUTION y un solo CARRYOVER_DEPOSIT por
  /// (usuario, mes). Movimientos manuales (MANUAL_*) y DEBT_COVERAGE pueden
  /// no estar asociados a un mes (`monthRecordId NULL`); el índice único
  /// no aplica con NULLs en Postgres, así que no los limita.
  @@unique([userId, monthRecordId, kind], name: "uq_savings_one_per_kind_per_month")
}

/// WebAuthn / FIDO2 credential ("passkey") registered by a user. Sign-in
/// happens through the `Passkey` CredentialsProvider in `src/lib/auth.ts`,
/// which calls `verifyAuthenticationResponse` from `@simplewebauthn/server`
/// using the public key persisted here. We store the credential id in
/// base64url, exactly the way the WebAuthn API surfaces it on the client,
/// so the lookup is a direct primary-key hit.
model Passkey {
  /// Base64URL-encoded credential id (WebAuthn `rawId`). Unique per browser
  /// + authenticator combo, so it doubles as the primary key.
  id                  String   @id
  userId              String
  /// Base64URL-encoded COSE public key returned by `verifyRegistrationResponse`.
  credentialPublicKey String
  /// Authenticator signature counter; bumped on every successful auth and
  /// monotonically increasing. A regression here flags a cloned authenticator.
  counter             Int      @default(0)
  /// "singleDevice" (platform-bound) or "multiDevice" (synced via iCloud /
  /// Google Password Manager / Bitwarden / 1Password).
  deviceType          String
  /// `true` when the credential is backed up to a passkey provider, so we can
  /// warn the user if they're about to delete their only platform passkey.
  backedUp            Boolean  @default(false)
  /// Subset of {"usb","nfc","ble","internal","hybrid","cable","smart-card"}.
  transports          String[] @default([])
  /// User-visible label ("MacBook Touch ID", "iPhone", "YubiKey 5C").
  name                String
  lastUsedAt          DateTime?
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Idempotency log for Stripe webhook events. Inserted by the webhook
/// handler **before** applying side effects; a duplicate event id makes
/// the insert fail (P2002) and the handler returns 200 without re-running.
model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([type])
}

/// Personal Access Token (bearer) used by the user-scoped MCP server at
/// `/api/mcp/user`. We persist a sha-256 hash of the token (never the
/// plaintext) plus a short prefix so the user can identify the token in the
/// settings UI without ever seeing the secret again after creation.
model ApiToken {
  id          String    @id @default(cuid())
  userId      String
  /// Human-readable label set by the user ("Claude Desktop", "Cursor", etc.).
  name        String
  /// Hex sha-256 hash of the token. The plaintext is shown once, on creation.
  tokenHash   String    @unique
  /// First 12 chars of the token (e.g. `ada_pat_3f8a`) for UI display.
  prefix      String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

// Removed: `TtsAudioCache` was an old workaround for serving OpenAI TTS
// MP3 to a third-party service. Migration `20260428220500_drop_tts_audio_cache`
// drops the table; we now upload TTS to Vercel Blob (`src/lib/blob/tts.ts`)
// and serve the signed URL directly to the web client.
