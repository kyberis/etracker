{
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npx prisma migrate deploy; fi && npm run build",
  "crons": [
    {
      "path": "/api/cron/daily-nudge",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/account-purge",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/bank-sync",
      "schedule": "0 */6 * * *"
    }
  ]
}
