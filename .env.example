DATABASE_URL="postgresql://postgres:postgres@localhost:5432/etracker?schema=public"
# Neon / managed Postgres on Vercel: add sslmode=verify-full (or your provider's
# recommendation) to silence the node-pg SSL deprecation warning in logs.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth (optional). Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI for the in-app expenses chat assistant
OPENAI_API_KEY=""
# Optional: override the default chat model (must support vision + tools)
OPENAI_MODEL="gpt-4o"
# Optional: Whisper model for WhatsApp voice notes (default whisper-1)
# OPENAI_TRANSCRIPTION_MODEL="whisper-1"
# Optional: outbound WhatsApp voice replies (OpenAI TTS MP3 via Twilio mediaUrl).
# Requires a public HTTPS app URL (set NEXT_PUBLIC_APP_URL on Vercel). Replies must be ≤4096 chars for TTS.
# WHATSAPP_VOICE_REPLY="true"
# OPENAI_TTS_MODEL="tts-1"
# OPENAI_TTS_VOICE="nova"

# Used for absolute links (Twilio fetching TTS audio); set in production (e.g. https://your-domain.com).
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# In-app chat can play TTS via POST /api/audio/speech (requires signed-in session). No extra env beyond OPENAI_*.
# Optional: override pricing (USD per 1M tokens) for cost logs when using a
# model that's not in the built-in pricing table (src/lib/ai/cost.ts).
# OPENAI_PRICE_INPUT_PER_M="2.50"
# OPENAI_PRICE_CACHED_INPUT_PER_M="1.25"
# OPENAI_PRICE_OUTPUT_PER_M="10.00"

# Twilio WhatsApp for the chat assistant on WhatsApp. The same credentials can
# be reused across Twilio products (e.g. another project's outbound alerts).
# TWILIO_WHATSAPP_FROM is the Twilio sender (sandbox or approved sender) and
# must include the `whatsapp:` channel prefix.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Optional but recommended on Vercel: paste the exact "Webhook URL for incoming
# messages" from Twilio here so request signature validation always matches.
# TWILIO_WEBHOOK_PUBLIC_URL="https://etracker.trefolio.com/api/webhooks/whatsapp"

# GoCardless Bank Account Data (Revolut / Open Banking)
# https://bankaccountdata.gocardless.com/user-secrets/
GOCARDLESS_SECRET_ID=""
GOCARDLESS_SECRET_KEY=""
