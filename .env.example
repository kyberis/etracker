### Core ###
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/etracker?schema=public"
# Used by `prisma migrate deploy` in CI/local; defaults to DATABASE_URL when unset.
# DATABASE_URL_UNPOOLED=

# Neon / managed Postgres on Vercel: add sslmode=verify-full (or your provider's
# recommendation) to silence the node-pg SSL deprecation warning in logs.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

### Google OAuth (optional) ###
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

### AI (Vercel AI Gateway, recommended) ###
# Run `vercel link` once and `vercel env pull .env.local` periodically; this
# provisions VERCEL_OIDC_TOKEN automatically and is the preferred auth path.
# VERCEL_OIDC_TOKEN=

# Fallback when OIDC isn't available (CI runners, local without `vercel env pull`).
# Get it from https://vercel.com/<team>/<project>/settings → AI Gateway.
# AI_GATEWAY_API_KEY=

# Override the model used by chat / WhatsApp agent and (optionally) the
# Revolut classifier. Defaults: openai/gpt-5.4 for chat, openai/gpt-4.1-mini
# for classification. Use the `provider/model` AI Gateway format.
# AI_MODEL="openai/gpt-5.4"
# AI_CLASSIFIER_MODEL="openai/gpt-4.1-mini"

# Legacy: only used as fallbacks for AI_MODEL. Direct OpenAI fetch (no gateway)
# is still used by /lib/ai/text-to-speech.ts because the gateway doesn't
# expose the speech endpoint yet.
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o"

# Optional: Whisper model for WhatsApp voice notes (default whisper-1)
# OPENAI_TRANSCRIPTION_MODEL="whisper-1"

### TTS (WhatsApp & in-app voice replies) ###
# Outbound WhatsApp voice replies (OpenAI TTS MP3 via Twilio mediaUrl).
# Requires a public HTTPS app URL (set NEXT_PUBLIC_APP_URL on Vercel). Replies
# must be ≤4096 chars for TTS.
# WHATSAPP_VOICE_REPLY="true"
# OPENAI_TTS_MODEL="gpt-4o-mini-tts"
# OPENAI_TTS_VOICE="nova"
# OPENAI_TTS_INSTRUCTIONS=""

# Used for absolute links (Twilio fetching TTS audio) and as the canonical
# origin for sitemap.xml / robots.txt / OpenGraph / JSON-LD. Production
# (Vercel): https://clara.trefolio.com
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

### SEO / Search Console verification (optional) ###
# Paste the verification token (just the value of the `content` attribute,
# not the full <meta> tag) from each console. Both are emitted from the
# root <head> via `metadata.verification` in src/app/layout.tsx.
# Google: https://search.google.com/search-console → property → Settings → Ownership verification → HTML tag.
# GOOGLE_SITE_VERIFICATION=""
# Bing:   https://www.bing.com/webmasters → Settings → Verify ownership → Meta tag.
# BING_SITE_VERIFICATION=""

### WhatsApp (Twilio) ###
# Same credentials can be reused across Twilio products (e.g. another project's
# outbound alerts). TWILIO_WHATSAPP_FROM is the Twilio sender (sandbox or
# approved sender) and must include the `whatsapp:` channel prefix.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Optional but recommended on Vercel: paste the exact "Webhook URL for incoming
# messages" from Twilio here so request signature validation always matches.
# TWILIO_WEBHOOK_PUBLIC_URL="https://clara.trefolio.com/api/webhooks/whatsapp"
# Optional: paste the exact "Status callback URL" if signature validation fails
# behind a proxy — path must be /api/webhooks/whatsapp/status
# TWILIO_STATUS_CALLBACK_PUBLIC_URL="https://clara.trefolio.com/api/webhooks/whatsapp/status"

### Telegram (Bot API) ###
# Telegram is the second conversational channel for Clara, alongside WhatsApp.
# Create a bot with @BotFather; upload `public/clara-icon-512.png` via
# /setuserpic and `/setdescription` "Clara, tu asistente de plata.".
#
# `TELEGRAM_BOT_USERNAME` is the handle without the leading @ (e.g. "ClaraTreBot").
# `TELEGRAM_WEBHOOK_SECRET` is sent back as `X-Telegram-Bot-Api-Secret-Token`
# on every inbound update; the webhook handler rejects requests without it.
# `TELEGRAM_LINK_TOKEN_SECRET` signs the deep-link tokens minted by
# `/api/settings/telegram` (HMAC-SHA256). Falls back to NEXTAUTH_SECRET when
# unset, but production should use a dedicated key.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
# TELEGRAM_LINK_TOKEN_SECRET=""

# Used by `npm run telegram:webhook` to register the webhook with Telegram.
# Must be the public URL Vercel serves the route at.
# TELEGRAM_WEBHOOK_URL="https://clara.trefolio.com/api/webhooks/telegram"

### Revolut / Open Banking (GoCardless Bank Account Data) ###
# https://bankaccountdata.gocardless.com/user-secrets/
GOCARDLESS_SECRET_ID=""
GOCARDLESS_SECRET_KEY=""

### Cloudflare Turnstile (captcha for /register and /login, optional) ###
# Without these, signup and login still work — the verifier degrades to a
# no-op when no secret key is set. Configure in production to keep bots out.
# Get the keys from https://dash.cloudflare.com/?to=/:account/turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
# Hard-disable Turnstile (both client widget and server check) in any
# environment by setting this to "1". Useful for staging or smoke tests.
# TURNSTILE_DISABLED=""
# NEXT_PUBLIC_TURNSTILE_DISABLED=""

### Email verification (Resend, recommended) ###
# When set, the email/password sign-up flow sends a signed verification link
# (JWT, expires in 24h) and refuses to issue a session until the link is
# clicked. When unset, sign-up still works but the verification email is
# logged instead of sent — fine for `next dev`, NOT recommended in
# production.
#
# Env-var names are intentionally identical to trefolio's so the same Vercel
# project configuration (Resend account, sender domain, signing secret) can
# be reused by Clara without renaming anything:
#
#   - RESEND_API_KEY        — same Resend secret as trefolio.
#   - RESEND_FROM_ADDRESS   — sender; default points at clara.trefolio.com,
#                             override per environment if you self-host.
#   - APP_BASE_URL          — public origin used to build absolute links in
#                             the verification email. Preferred over
#                             NEXT_PUBLIC_APP_URL / NEXTAUTH_URL, which are
#                             still honoured as fallbacks.
#   - APP_SESSION_SECRET    — JWT signing secret for the verification token.
#                             Preferred over NEXTAUTH_SECRET, which is also
#                             honoured for backwards compat.
# RESEND_API_KEY=""
# RESEND_FROM_ADDRESS="Clara <noreply@clara.trefolio.com>"
# APP_BASE_URL="http://localhost:3000"
# APP_SESSION_SECRET="replace-with-a-long-random-string"

### Rate limiting (Upstash Redis, optional) ###
# Without these, rate limiters fail open (no limiting) — fine for local dev.
# Get them from https://console.upstash.com/ → Redis → Rest API.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

### Observability (optional) ###
# When set, error-level logs are forwarded to Sentry via dynamic import of
# `@sentry/nextjs` (the package is *not* a hard dep — install it yourself if you
# want this).
# SENTRY_DSN=""
